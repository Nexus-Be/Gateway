{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:8001",
    "Audience": "shoppingcart-api",
    "Signature": "SuperSecretNexusDevelopmentKeyForGatewayAuth1234567890!",
    "RequireHttpsMetadata": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "admin-route": {
        "ClusterId": "user-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/admin/user/{**catch-all}"
          }
        ]
      },
      "auth-route": {
        "ClusterId": "user-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "user-me-route": {
        "ClusterId": "user-cluster",
        "Order": 11,
        "Match": {
          "Path": "/api/v1/me/{**catch-all}"
        }
      },
      "user-me-direct": {
        "ClusterId": "user-cluster",
        "Order": 12,
        "Match": {
          "Path": "/api/v1/me"
        }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Order": 20,
        "Match": {
          "Path": "/api/v1/user/{**catch-all}"
        }
      },
      "seller-route": {
        "ClusterId": "user-cluster",
        "Order": 21,
        "Match": {
          "Path": "/api/v1/sellers/{**catch-all}"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Order": 30,
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "catalog-products-route": {
        "ClusterId": "catalog-cluster",
        "Order": 31,
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },
      "commerce-carts-route": {
        "ClusterId": "commerce-cluster",
        "Order": 40,
        "Match": {
          "Path": "/api/v1/carts/{**catch-all}"
        }
      },
      "commerce-orders-route": {
        "ClusterId": "commerce-cluster",
        "Order": 41,
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "log-route": {
        "ClusterId": "log-cluster",
        "Order": 50,
        "Match": {
          "Path": "/api/v1/logs/{**catch-all}"
        }
      },
      "auction-auctions-route": {
        "ClusterId": "auction-cluster",
        "Order": 60,
        "Match": {
          "Path": "/api/v1/auctions/{**catch-all}"
        }
      },
      "auction-bids-route": {
        "ClusterId": "auction-cluster",
        "Order": 61,
        "Match": {
          "Path": "/api/v1/bids/{**catch-all}"
        }
      },
      "fulfillment-warehouses-route": {
        "ClusterId": "fulfillment-cluster",
        "Order": 70,
        "Match": {
          "Path": "/api/v1/warehouses/{**catch-all}"
        }
      },
      "fulfillment-shipments-route": {
        "ClusterId": "fulfillment-cluster",
        "Order": 71,
        "Match": {
          "Path": "/api/v1/shipments/{**catch-all}"
        }
      },
      "notification-notifications-route": {
        "ClusterId": "notification-cluster",
        "Order": 80,
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "notification-email-route": {
        "ClusterId": "notification-cluster",
        "Order": 81,
        "Match": {
          "Path": "/api/v1/email/{**catch-all}"
        }
      },
      "wallet-wallets-route": {
        "ClusterId": "wallet-cluster",
        "Order": 90,
        "Match": {
          "Path": "/api/v1/wallets/{**catch-all}"
        }
      },
      "checkheal-route": {
        "ClusterId": "checkheal-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/v1/checkheal/{**catch-all}"
        }
      },
      "checkheal-health-route": {
        "ClusterId": "checkheal-cluster",
        "Order": 101,
        "Match": {
          "Path": "/health/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:8001"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-service": {
            "Address": "http://localhost:8002"
          }
        }
      },
      "commerce-cluster": {
        "Destinations": {
          "commerce-service": {
            "Address": "http://localhost:8003"
          }
        }
      },
      "log-cluster": {
        "Destinations": {
          "log-service": {
            "Address": "http://localhost:8004"
          }
        }
      },
      "auction-cluster": {
        "Destinations": {
          "auction-service": {
            "Address": "http://localhost:8005"
          }
        }
      },
      "fulfillment-cluster": {
        "Destinations": {
          "fulfillment-service": {
            "Address": "http://localhost:8006"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://localhost:8007"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": {
            "Address": "http://localhost:8008"
          }
        }
      },
      "checkheal-cluster": {
        "Destinations": {
          "checkheal-service": {
            "Address": "http://localhost:8009"
          }
        }
      }
    }
  }
}
